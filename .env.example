DB_HOST=localhost
DB_PORT=5432
DB_NAME=clubos
DB_USER=clubos_user
DB_PASSWORD=replace-with-your-local-password

APP_ENV=development
ATTACHMENT_STORAGE_BACKEND=local
ATTACHMENT_STORAGE_DIRECTORY=.clubos-attachments
# Required for uploads. Set this to your private ClamAV Unix socket.
# ATTACHMENT_SCAN_SOCKET=/run/clamav/clamd.sock
# Required for production. Use the exact HTTPS origin without a path.
# PUBLIC_ORIGIN=https://clubos.example.org
COOKIE_SECURE=false
